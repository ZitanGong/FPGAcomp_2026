// Dock silk KEY0 / USER_BUTTON0: timbre select.
IO_LOC "key0_n" AA13;
// Dock silk KEY1 / USER_BUTTON1: volume down.
IO_LOC "key1_n" AB13;
// Dock silk KEY2 / USER_BUTTON2: volume up.
IO_LOC "key2_n" Y12;
IO_PORT "key0_n" IO_TYPE=LVCMOS33 PULL_MODE=UP;
IO_PORT "key1_n" IO_TYPE=LVCMOS33 PULL_MODE=UP;
IO_PORT "key2_n" IO_TYPE=LVCMOS33 PULL_MODE=UP;
IO_LOC "shld" AA21;
IO_LOC "key_clk" AB20;
IO_LOC "key_in[0]" AA19;
// PMOD0_IO5 (J9 pin 8), moved off the SDRAM0 address bus.
IO_LOC "key_in[1]" R17;
// PMOD0_IO4 (J9 pin 7), moved off the SDRAM0 write-enable signal.
IO_LOC "key_in[2]" P16;
// Frame debug: SDRAM0_A1 / J13-38. D19 / J13-37 is now led_clk.
IO_LOC "dbg_frame" E19;
IO_LOC "dbg_key" R18;
IO_LOC "dbg_err" T18;
IO_PORT "shld" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=4;
IO_PORT "key_clk" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=4;
IO_PORT "key_in[0]" IO_TYPE=LVCMOS33 PULL_MODE=UP;
IO_PORT "key_in[1]" IO_TYPE=LVCMOS33 PULL_MODE=UP;
IO_PORT "key_in[2]" IO_TYPE=LVCMOS33 PULL_MODE=UP;
IO_PORT "dbg_frame" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=4;
IO_PORT "dbg_key" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=4;
IO_PORT "dbg_err" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=4;
IO_LOC "dbg_ref" AA20;
IO_LOC "dbg_lock" Y22;
IO_LOC "dbg_rst" AB21;
IO_PORT "dbg_ref" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=4;
IO_PORT "dbg_lock" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=4;
IO_PORT "dbg_rst" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=4;
IO_LOC "hp_bclk" Y17;
IO_LOC "hp_ws" AB17;
IO_LOC "hp_sd" AA16;
IO_LOC "pa_n" AB16;
IO_PORT "hp_bclk" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=4;
IO_PORT "hp_ws" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=4;
IO_PORT "hp_sd" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=4;
IO_PORT "pa_n" IO_TYPE=LVCMOS33 PULL_MODE=UP DRIVE=4;

// MPR121: J13-1/3/5. GND is J13-12, NOT J13-2. Supply 3.3 V.
IO_LOC "touch_scl" E14;
IO_LOC "touch_sda" C15;
IO_LOC "touch_irq_n" B13;
IO_PORT "touch_scl" IO_TYPE=LVCMOS33 PULL_MODE=UP DRIVE=4;
IO_PORT "touch_sda" IO_TYPE=LVCMOS33 PULL_MODE=UP DRIVE=4;
IO_PORT "touch_irq_n" IO_TYPE=LVCMOS33 PULL_MODE=UP;
// LED DATA / CLK / STCP: J13-35 / J13-37 / J13-39.
IO_LOC "led_data" C20;
IO_LOC "led_clk" D19;
IO_LOC "led_lat" C19;

IO_PORT "led_data" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=4;
IO_PORT "led_clk" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=4;
IO_PORT "led_lat" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=4;
